<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.valle.boleteria</groupId>
  <artifactId>boleteria-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Boleteria Baloncesto Valle del Cauca</name>
  <description>Prueba técnica CODESA — sistema de boletería (auth, catalog, sales + Angular)</description>

  <modules>
    <module>backend/common</module>
    <module>backend/auth-service</module>
    <module>backend/catalog-service</module>
    <module>backend/sales-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.7</jjwt.version>
    <springdoc.version>2.8.13</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        IMPORTANTE: jackson-bom va ANTES de jjwt-bom. jjwt-bom hereda de jjwt-root la
        gestión de jackson-databind:2.12.7.1, que desalinea Jackson con Spring Boot 3.5
        y provoca NoClassDefFoundError: ToEmptyObjectSerializer al arrancar. El primer
        BOM importado gana; al reimportar jackson-bom de Boot aquí, todo queda alineado.
      -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-bom</artifactId>
        <version>${jjwt.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.valle.boleteria</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
